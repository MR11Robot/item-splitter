{
	"schemaVersion": 1,
	"id": "item-splitter",
	"version": "${version}",
	"name": "Item Splitter",
	"description": "Split item stacks into smaller amounts with configurable keybinds.",
	"authors": [
		"therealdp"
	],
	"contact": {
		"sources": "https://github.com/mr11robot/item-splitter"
	},
	"license": "MIT",
	"icon": "assets/item-splitter/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.therealdp.itemsplitter.ItemSplitter"
		],
		"client": [
			"com.therealdp.itemsplitter.ItemSplitterClient"
		]
	},
	"mixins": [
		"item-splitter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}